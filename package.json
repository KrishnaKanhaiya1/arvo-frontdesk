{
  "name": "arvo-frontdesk-workspace",
  "version": "1.0.0",
  "description": "Arvo Frontdesk - Full Stack Support Ticket & SLA System",
  "private": true,
  "scripts": {
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend && npm run dev",
    "build": "npm run build:backend && npm run build:frontend",
