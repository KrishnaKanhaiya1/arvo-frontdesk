# ── Arvo Frontdesk Backend Environment Template (Production) ──
PORT=3001
NODE_ENV=production

# Production PostgreSQL Database with SSL
DATABASE_URL="postgresql://arvo_user:SUPER_SECURE_PASSWORD@db.example.internal:5432/arvo_prod?sslmode=require"

# Mandatory: 64-character cryptographically secure session signing secret
# Generate via: openssl rand -hex 32
SESSION_SECRET="CHANGE_ME_TO_A_CRYPTOGRAPHICALLY_SECURE_RANDOM_STRING_AT_LEAST_32_CHARS"

# Evaluator/Demo Login Password (configured separately from production passwords)
DEMO_PASSWORD="arvo2026"

# Production Frontend Origin (Strict CORS & Cookie Domain Security)
FRONTEND_URL="https://arvo-frontdesk.vercel.app"
